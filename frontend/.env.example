# API Laravel — utilisé par src/api/axiosClient.js
# En dev Vite proxifie /api vers 8000, donc vide = relatif.
# En prod (build) : mettre l'URL complète.
VITE_API_URL=/api
# Exemple prod :
# VITE_API_URL=http://localhost:8000/api

# URL backend pour images /storage
VITE_BACKEND_URL=http://localhost:8000

# Nom app (optionnel)
VITE_APP_NAME="Tany & Toerana"
